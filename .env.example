SUPABASE_SERVICE_ROLE_KEY=

# Optional Direct Database / Migration Connection String
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. OPTIONAL THIRD-PARTY INTEGRATIONS (Server-Only Secrets)
