VITE_SUPABASE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# 2. SERVER / VERCEL SECRET VARIABLES (Serverless Functions & API Routes)
# ------------------------------------------------------------------------------
# Required server-only credentials for /api/* routes. NEVER expose to the browser!
